generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// Models

model Song {
  id String @id @default(uuid())
  title String
  artist String?
  key String?
  lyrics String @db.Text
  chords String? @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}