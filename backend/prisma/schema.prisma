generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
  importFileExtension = "ts"
}

datasource db {
  provider = "postgresql"
}

// Models

model Song {
  id String @id @default(uuid())
  title String
  artist String?
  key String?
  lyrics String @db.Text
  chords String? @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  setlistItems SetlistItem[]
}

enum EventType {
  WORSHIP
  REHEARSAL
}

model MinistryEvent {
  id        String        @id @default(uuid())
  title     String
  type      EventType
  startsAt  DateTime
  location  String?
  notes     String?       @db.Text
  setlist   SetlistItem[]
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
}

model SetlistItem {
  id       String        @id @default(uuid())
  eventId  String
  songId   String
  position Int
  key      String?

  event MinistryEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)
  song  Song          @relation(fields: [songId], references: [id], onDelete: Restrict)

  @@unique([eventId, position])
}